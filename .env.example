# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket.appspot.com

FIREBASE_WEB_API_KEY=your_web_api_key
FIREBASE_ANDROID_API_KEY=your_android_api_key
FIREBASE_IOS_API_KEY=your_ios_api_key
FIREBASE_MAC_API_KEY=your_mac_api_key
FIREBASE_WINDOWS_API_KEY=your_windows_api_key

# Web App
WEB_APP_ID=your_web_app_id
WEB_AUTH_DOMAIN=your_project_id.firebaseapp.com
WEB_MEASUREMENT_ID=your_web_measurement_id

# Android App
ANDROID_APP_ID=your_android_app_id

# iOS / MacOS App
IOS_APP_ID=your_ios_app_id
IOS_BUNDLE_ID=com.example.unionInterface

# Windows App
WINDOWS_APP_ID=your_windows_app_id
WINDOWS_AUTH_DOMAIN=your_project_id.firebaseapp.com
WINDOWS_MEASUREMENT_ID=your_windows_measurement_id

# Cloudflare R2 Cloud Functions Endpoints
R2_SIGN_UPLOAD_ENDPOINT=https://us-central1-your_project_id.cloudfunctions.net/createR2UploadUrl
R2_DELETE_FILE_ENDPOINT=https://us-central1-your_project_id.cloudfunctions.net/deleteR2File

